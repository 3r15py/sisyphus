# Copy to .env for local runs of `npm run dream`.
# In production these live as GitHub Actions secrets/variables, not in the repo.

# REQUIRED. The project files no entry without it - there is no fallback generator.
LLM_API_KEY=

# Any OpenAI-compatible chat completions endpoint.
# OpenAI (default):    https://api.openai.com/v1/chat/completions
# OpenRouter:          https://openrouter.ai/api/v1/chat/completions
# Groq:                https://api.groq.com/openai/v1/chat/completions
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-5-mini

DREAM_INTERVAL_MINUTES=20
